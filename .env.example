# MySQL 8 connection string (required)
DATABASE_URL=mysql://user:password@host:3306/dbname

# Kimi OAuth credentials issued by the platform (required at boot in production;
# placeholder values let the server start but admin login needs real credentials)
APP_ID=your-app-id
APP_SECRET=your-app-secret
KIMI_AUTH_URL=https://www.kimi.com/api/oauth
KIMI_OPEN_URL=https://api.kimi.com
OWNER_UNION_ID=

# Compile time login page values
VITE_APP_ID=your-app-id
VITE_KIMI_AUTH_URL=https://www.kimi.com/api/oauth
